red":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCustomPodMeasurement"}}}},"responses":{"201":{"description":""}},"tags":["Measurement"],"security":[{"bearer":[]}]}},"/measurements/api/podEnd":{"post":{"operationId":"MeasurementController_createPodEnd","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCustomPodMeasurement"}}}},"responses":{"201":{"description":""}},"tags":["Measurement"],"security":[{"bearer":[]}]}},"/margincalc":{"post":{"operationId":"Real time cost Calculation","summary":"","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateMargincalcDto"}}}},"responses":{"201":{"description":""}},"tags":["Cost and Profit"],"security":[{"bearer":[]}]}},"/margincalc/cost":{"post":{"operationId":"Find Cost for Infra","summary":"","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetCostDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"type":"object"}}}}}},"tags":["Cost and Profit"],"security":[{"bearer":[]}]}},"/onboarding/stripe":{"post":{"operationId":"OnboardingController_create","summary":"","description":"Onboard a stripe standard account to be assocaited with your user account","parameters":[],"responses":{"200":{"description":"Response for creating a stripe account","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OnboardingResponseDTO"}}}},"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OnboardingResponseDTO"}}}},"409":{"description":"Response for when a new connection is attempted to be established for an existing account","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConflictException"}}}}},"tags":["Onboarding"]},"delete":{"operationId":"OnboardingController_re