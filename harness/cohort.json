{
  "job_name": "meta-muse-opus-eight-rollout-reproduction-20260824",
  "jobs_dir": "sample-run/raw",
  "n_attempts": 8,
  "n_concurrent_trials": 12,
  "quiet": false,
  "retry": {
    "max_retries": 2,
    "exclude_exceptions": [
      "AgentTimeoutError",
      "VerifierTimeoutError",
      "RewardFileNotFoundError",
      "RewardFileEmptyError",
      "VerifierOutputParseError",
      "ApiUsageLimitError"
    ],
    "wait_multiplier": 1.0,
    "min_wait_sec": 2.0,
    "max_wait_sec": 60.0
  },
  "environment": {
    "type": "daytona",
    "override_storage_mb": 10240,
    "kwargs": {
      "connection_pool_maxsize": 32,
      "labels": {
        "cohort": "meta-muse-opus-eight-rollout-reproduction-20260824"
      }
    }
  },
  "agents": [
    {
      "import_path": "harness.harbor_agents:OpenRouterMiniSweAgent",
      "model_name": "openrouter/meta/muse-spark-1.2",
      "n_concurrent": 3,
      "kwargs": {
        "version": "2.4.5",
        "cost_limit": "0",
        "config_file": "harness/mini-swe-openrouter.yaml",
        "reasoning_effort": "high"
      },
      "env": {
        "MSWEA_API_KEY": "${OPENROUTER_API_KEY}"
      }
    },
    {
      "import_path": "harness.harbor_agents:BedrockMiniSweAgent",
      "model_name": "bedrock/us.anthropic.claude-opus-5",
      "n_concurrent": 8,
      "kwargs": {
        "version": "2.4.5",
        "cost_limit": "0",
        "config_file": "harness/mini-swe-bedrock.yaml",
        "reasoning_effort": "high"
      },
      "env": {
        "BEDROCK_PROVIDER_AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "BEDROCK_PROVIDER_AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "BEDROCK_PROVIDER_AWS_SESSION_TOKEN": "${AWS_SESSION_TOKEN:-}",
        "BEDROCK_PROVIDER_AWS_REGION": "${AWS_REGION:-us-east-1}"
      }
    }
  ],
  "tasks": [
    { "path": "tasks/02-entitlement-overage-lines" },
    { "path": "tasks/04-measurement-failure-dlq" },
    { "path": "tasks/05-customer-communication-dispatch" }
  ]
}
