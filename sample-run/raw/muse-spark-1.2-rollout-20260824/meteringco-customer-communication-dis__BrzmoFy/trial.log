environment:
  env:
    # mini-swe-agent executes the model's bash with `os.environ | environment.env`,
    # so the provider key would otherwise be readable by every command the model
    # issues, and any `env` dump would land in the trajectory we upload to S3.
    # Blanking it here leaves the key with LiteLLM inside the agent process and
    # out of the shell the model drives. Bedrock rollouts get this for free:
    # their credentials live in a profile file, never in the environment.
    OPENROUTER_API_KEY: ''
    # Repeated from the builtin mini config: a -c layer that replaces this map
    # rather than merging into it would otherwise drop them, and an interactive
    # pager hangs a command until the step times out.
    PAGER: cat
    MANPAGER: cat
    LESS: -R
    PIP_PROGRESS_BAR: 'off'
    TQDM_DISABLE: '1'

MSWEA_CONFIG_EOF_9c23f79a

