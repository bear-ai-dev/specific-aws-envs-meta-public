# Copy to .env and fill only the credentials needed for your run.

DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Muse through OpenRouter.
OPENROUTER_API_KEY=

# Muse through Meta's Responses API (Task 14 reproduction).
META_API_KEY=

# Opus through Amazon Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Routes, attempts, concurrency, and reasoning settings are frozen in
# harness/cohort.json and harness/task14-cohort.json rather than selected
# through environment variables.
